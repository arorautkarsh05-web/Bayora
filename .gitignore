# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environments
.venv/
env/
venv/

# Cryptographic Keys & Secrets (Must NEVER be committed to VCS)
backend/data/keys/*.pem
